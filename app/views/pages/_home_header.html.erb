<%# app/views/pages/_home_header.html.erb %>
<header class="site-header site-header--sticky">
  <div class="container site-header__row">
    <%= link_to "#top", class: "site-header__brand", aria: { label: "milkshark – nach oben" } do %>
      <%= render "pages/wordmark" %>
    <% end %>
    <nav class="nav">
      <%= link_to "Leistungen", "#leistungen", class: "nav__link" %>
      <%= link_to "Ansatz", "#ansatz", class: "nav__link" %>
      <%= link_to "Kontakt", "#kontakt", class: "nav__link" %>
    </nav>
  </div>
</header>
