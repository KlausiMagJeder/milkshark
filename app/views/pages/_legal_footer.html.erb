<%# app/views/pages/_legal_footer.html.erb %>
<%# local: active_page (:impressum oder :datenschutz) %>
<footer class="site-footer">
  <div class="container site-footer__row">
    <span><%= Date.current.year %> Milkshark</span>
    <span class="site-footer__links">
      <%= link_to "Startseite", root_path %>
      <% if active_page == :impressum %>
        <%= link_to "Datenschutz", datenschutz_path %>
      <% else %>
        <%= link_to "Impressum", impressum_path %>
      <% end %>
    </span>
  </div>
</footer>
