<%# app/views/pages/_legal_header.html.erb %>
<%# local: active_page (:impressum oder :datenschutz) %>
<header class="site-header">
  <div class="container site-header__row">
    <%= link_to root_path, class: "site-header__brand", aria: { label: "milkshark – Startseite" } do %>
      <%= render "pages/wordmark" %>
    <% end %>
    <nav class="nav">
      <%= link_to "Impressum", impressum_path, class: class_names("nav__link", "nav__link--active" => active_page == :impressum) %>
      <%= link_to "Datenschutz", datenschutz_path, class: class_names("nav__link", "nav__link--active" => active_page == :datenschutz) %>
    </nav>
  </div>
</header>
